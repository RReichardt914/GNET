stimuli <- picdat_clean %>%
filter(!str_detect(pict, "^prototype"))
# ----------------------------
# Step 5: Build stimulus-level table
# ----------------------------
stimulus_table <- stimuli %>%
group_by(base_id, type, phase) %>%
summarise(
arr = list(across(V1:V9)[!str_detect(pict, "col|sha"), ] %>% as.numeric()),
col = list(across(V1:V9)[str_detect(pict, "col"), ] %>% as.numeric()),
sha = list(across(V1:V9)[str_detect(pict, "sha"), ] %>% as.numeric()),
.groups = "drop"
)
# ----------------------------
# Step 6: Compute distances within type + phase
# ----------------------------
diffinnovs2 <- stimulus_table %>%
filter(!is.na(type), !is.na(phase)) %>%
group_by(type, phase) %>%
group_modify(function(df, key) {
n <- nrow(df)
map_dfr(1:n, function(i) {
distances <- map_dbl(1:n, function(j) {
if (i == j) return(NA_real_)
arr_dist <- hamming_dist(df$arr[[i]], df$arr[[j]])
col_dist <- hamming_dist(df$col[[i]], df$col[[j]])
sha_dist <- hamming_dist(df$sha[[i]], df$sha[[j]])
arr_dist + col_dist + sha_dist
})
tibble(
stimulus_id = df$base_id[i],
dmean = mean(distances, na.rm = TRUE),
dalls = sum(distances, na.rm = TRUE)
)
})
}) %>%
ungroup()
View(diffinnovs2)
View(diffinnovs)
View(diffinnovs2)
source("01_DIFFERENCE_CALCULATIONS.R")
library(tidyverse)
library(ez)
library(emmeans)
library(DescTools)
library(afex)
library(effsize)
library(Hmisc)
gnet2_data <- read_csv(
"gnet_v2_jd_data.csv",
locale = locale(encoding = "UTF-8")
) %>%
select(
count_study_sequence,
count_test_sequence,
datetime,
response,
response_study_response,
response_test_response,
response_time,
response_time_study_response,
response_time_test_response,
stim,
stim_2,
studyResultId,
total_responses,
workerId
) %>%
filter(!is.na(workerId)) %>%
mutate(
stimtype = case_when(
is.na(count_test_sequence) & str_detect(stim_2, "prototype") ~ "prototype",
is.na(count_test_sequence) & str_detect(stim_2, "p[1-5]d1") ~ "D1",
is.na(count_test_sequence) & str_detect(stim_2, "p[1-5]d2") ~ "D2",
is.na(count_test_sequence) & str_detect(stim_2, "p[1-5]d3") ~ "D3",
is.na(count_test_sequence) & str_detect(stim_2, "p[1-5]d4") ~ "D4",
is.na(count_test_sequence) & str_detect(stim_2, "p[6-9]") ~ "D5",
is.na(count_test_sequence) & str_detect(stim_2, "p10") ~ "D5",
!is.na(count_test_sequence) & str_detect(stim, "p[1-5]d1") ~ "D1",
!is.na(count_test_sequence) & str_detect(stim, "p[1-5]d2") ~ "D2",
!is.na(count_test_sequence) & str_detect(stim, "p[1-5]d3") ~ "D3",
!is.na(count_test_sequence) & str_detect(stim, "p[1-5]d4") ~ "D4",
!is.na(count_test_sequence) & str_detect(stim, "p[6-9]") ~ "D5",
!is.na(count_test_sequence) & str_detect(stim, "p10") ~ "D5",
TRUE ~ NA_character_
),
test_quality = case_when(
str_detect(stim, "_[1-2]") & !is.na(response_time_test_response) ~ "fam",
str_detect(stim, "_[3-4]") & !is.na(response_time_test_response) ~ "new",
TRUE ~ NA_character_
),
rt_corr = case_when(
str_detect(stim, "_[1-2]") & response_test_response == "left"  ~ 1,
str_detect(stim, "_[1-2]") & response_test_response == "right" ~ 0,
str_detect(stim, "_[3-4]") & response_test_response == "left"  ~ 0,
str_detect(stim, "_[3-4]") & response_test_response == "right" ~ 1,
TRUE ~ NA_real_
)
)
# data and difference indices are used to calculate study and test indices
gnet2_data <- gnet2_data %>%
rowwise() %>%
mutate(
match_row = which(str_detect(stim_2, fixed(difference_indices$stimulus_id)))[1],
DTF = ifelse(is.na(match_row), 0, difference_indices$DTF[match_row]),
DTAF = ifelse(is.na(match_row), 0, difference_indices$DTAF[match_row]),
DTAN = ifelse(is.na(match_row), 0, difference_indices$DTAN[match_row]),
DTN = ifelse(is.na(match_row), 0, difference_indices$DTN[match_row])
) %>%
ungroup() %>%
select(-match_row) %>%
mutate(
identifier = paste0(workerId, "_", studyResultId)
)
# Calculate each participant's subjective difference ratings during the study phase.
# For every participant (workerId/studyResultId) and stimulus category (stimtype),
# compute both the mean and standard deviation of the difference judgments
# (response_study_response), then create a unique participant-session identifier.
# study DT ####
gnet2_data <- gnet2_data %>%
mutate(
response_study_response = na_if(response_study_response, "None"),
response_study_response = as.numeric(response_study_response)
)
mean_jds <- gnet2_data %>%
filter(
!is.na(response_study_response),
is.na(count_test_sequence)
) %>%
group_by(workerId, studyResultId, stimtype) %>%
summarise(
response_study_response = mean(response_study_response),
.groups = "drop"
)
sd_jds <- gnet2_data %>%
filter(
!is.na(response_study_response),
is.na(count_test_sequence)
) %>%
group_by(workerId, studyResultId, stimtype) %>%
summarise(
response_study_response = sd(response_study_response),
.groups = "drop"
)
mean_sd_jds <- mean_jds %>%
rename(mean_jd = response_study_response) %>%
left_join(
sd_jds %>%
rename(sd_jd = response_study_response),
by = c("workerId", "studyResultId", "stimtype")
)
mean_sd_jds <- mean_sd_jds %>%
mutate(
identifier = paste0(workerId, "_", studyResultId)
)
rm(mean_jds,sd_jds)
#####
# mean_sd_jds is output - difference ratings mean and sd for each group of stim for each participant
# Create a participant-level recognition memory contingency table.
# For each participant and stimulus type, count familiar hits, misses,
# novel correct rejections, false alarms, and missing responses.
# The resulting table contains one row per participant × stimulus type.
test_dat <- gnet2_data %>%
filter(!is.na(count_test_sequence)) %>%
count(
studyResultId,
workerId,
stimtype,
test_quality,
rt_corr,
name = "N"
) %>%
mutate(
identifier = paste0(workerId, "_", studyResultId)
)
test_dat_c <- test_dat %>%
complete(
identifier,
stimtype,
test_quality,
rt_corr,
fill = list(N = 0)
)
test_dat_compl <- test_dat_c %>%
mutate(
response_type = case_when(
test_quality == "fam" & is.na(rt_corr) ~ "fam_NA",
test_quality == "fam" & rt_corr == 1 ~ "fam_corr",
test_quality == "fam" & rt_corr == 0 ~ "fam_miss",
test_quality == "new" & is.na(rt_corr) ~ "new_NA",
test_quality == "new" & rt_corr == 1 ~ "new_corr",
test_quality == "new" & rt_corr == 0 ~ "new_fa"
)
) %>%
select(identifier, stimtype, response_type, N) %>%
pivot_wider(
names_from = response_type,
values_from = N,
values_fill = 0
) %>%
separate(
identifier,
into = c("workerId", "studyResultId"),
sep = "_",
remove = FALSE
) %>%
select(
studyResultId,
workerId,
stimtype,
identifier,
fam_NA,
fam_corr,
fam_miss,
new_NA,
new_corr,
new_fa
)
rm(test_dat,test_dat_c)
#####
# test_dat_compl is output
total_runs <- gnet2_data %>%
distinct(workerId, studyResultId) %>%
nrow()
# Runs with all 160 trials
usable <- gnet2_data %>%
count(workerId, studyResultId, name = "N") %>%
filter(N == 160) %>%
arrange(studyResultId) %>%
distinct(workerId, .keep_all = TRUE) %>%
mutate(
identifier = paste0(workerId, "_", studyResultId)
)
fineids <- usable$identifier
StudySummary <- gnet2_data %>%
filter(
is.na(count_test_sequence),
response == "left",
stimtype == "prototype"
) %>%
count(workerId, studyResultId, name = "n") %>%
mutate(R = n / 25) %>%
select(workerId, studyResultId, R)
StudyFA <- gnet2_data %>%
filter(
is.na(count_test_sequence),
response == "left",
stimtype != "prototype"
) %>%
count(workerId, studyResultId, name = "n") %>%
mutate(FA = n / 50) %>%
select(workerId, studyResultId, FA)
StudyCR <- StudySummary %>%
full_join(StudyFA, by = c("workerId", "studyResultId")) %>%
mutate(
FA = replace_na(FA, 0),
CR = R - FA
)
rm(StudySummary, StudyFA)
StudyBinom <- gnet2_data %>%
filter(
is.na(count_test_sequence),
response == "left"
) %>%
select(workerId, studyResultId, response, stimtype) %>%
mutate(
RespBinomial = if_else(stimtype == "prototype", 1, 0)
)
StudyCI <- StudyBinom %>%
group_by(workerId, studyResultId) %>%
summarise(
successes = sum(RespBinomial),
trials = n(),
.groups = "drop"
) %>%
rowwise() %>%
mutate(
confint = list(binconf(successes, trials)),
CI_lower = confint[1, 2],
CI_upper = confint[1, 3]
) %>%
ungroup() %>%
select(workerId, studyResultId, CI_lower, CI_upper)
View(mean_sd_jds)
source("01_DIFFERENCE_CALCULATIONS.R")
library(tidyverse)
library(ez)
library(emmeans)
library(DescTools)
library(afex)
library(effsize)
library(Hmisc)
View(picdat)
View(difference_indices)
gnet2_data <- read_csv(
"alldata_pilot2_alldiffind.csv",
locale = locale(encoding = "Windows-1250")
)
View(gnet2_data)
gnet2_data <- gnet2_data %>%
mutate(
stimulus_id = str_remove(stim, "\\.png$")
) %>%
left_join(
difference_indices %>%
select(stimulus_id, DTF, DTAF, DTAN, DTN),
by = "stimulus_id"
)
View(gnet2_data)
View(difference_indices)
# Na is changed to 0
gnet2_data <- gnet2_data %>%
mutate(
st_corr = replace_na(st_corr, 0)
)
# Create a unique participant-session identifier so that repeated runs
# by the same worker are treated as separate observations.
gnet2_data <- gnet2_data %>%
mutate(
identifier = str_c(workerId, studyResultId, sep = "_")
)
# GENERATE STUDY DT ####
# correct study responses by type
# divided by all study trials by type
# to calculate correct categorization rate (during study)
strecog <- gnet2_data %>%
filter(is.na(count_test_sequence)) %>%
group_by(studyResultId, workerId, stimtype) %>%
summarise(
CCategorization = sum(st_corr),
NrTrials = n(),
crrate = CCategorization / NrTrials,
.groups = "drop"
) %>%
mutate(
# Create a unique identifier for each participant-session combination
identifier = str_c(workerId, studyResultId, sep = "_")
)
View(strecog)
# GENERATE TEST DATA ####
# we calculate the number of all response types during test by participant and stimtype
test_dat_compl <- gnet2_data %>%
filter(!is.na(count_test_sequence)) %>%
mutate(
identifier = str_c(workerId, studyResultId, sep = "_"),
response_type = case_when(
test_quality == "fam" & is.na(rt_corr) ~ "fam_NA",
test_quality == "fam" & rt_corr == 1 ~ "fam_corr",
test_quality == "fam" & rt_corr == 0 ~ "fam_miss",
test_quality == "new" & is.na(rt_corr) ~ "new_NA",
test_quality == "new" & rt_corr == 1 ~ "new_corr",
test_quality == "new" & rt_corr == 0 ~ "new_fa"
)
) %>%
count(
studyResultId,
workerId,
stimtype,
identifier,
response_type
) %>%
pivot_wider(
names_from = response_type,
values_from = n,
values_fill = 0
)
View(test_dat_compl)
total_runs <- gnet2_data %>%
distinct(workerId, studyResultId) %>%
nrow()
usable <- gnet2_data %>%
count(workerId, studyResultId, name = "N") %>%
filter(N == 175) %>%
arrange(studyResultId) %>%
distinct(workerId, .keep_all = TRUE) %>%
mutate(identifier = paste(workerId, studyResultId, sep = "_"))
View(usable)
fineids <- unique(usable$identifier)
crates <- strecog %>%
filter(stimtype == "prototype") %>%
select(identifier, crrate)
View(crates)
View(strecog)
StudySummary <- gnet2_data %>%
filter(
is.na(count_test_sequence),
response == "left",
stimtype == "prototype"
) %>%
count(workerId, studyResultId, name = "n") %>%
mutate(R = n / 25) %>%
select(workerId, studyResultId, R)
View(StudySummary)
StudyFA <- gnet2_data %>%
filter(
is.na(count_test_sequence),
response == "left",
stimtype != "prototype"
) %>%
count(workerId, studyResultId, name = "n") %>%
mutate(FA = n / 50) %>%
select(workerId, studyResultId, FA)
View(StudyFA)
StudyCR <- StudySummary %>%
full_join(StudyFA, by = c("workerId", "studyResultId")) %>%
mutate(
FA = replace_na(FA, 0),
CR = R - FA
)
View(StudyCR)
View(StudyCR)
rm(StudySummary, StudyFA)
StudyBinom <- gnet2_data %>%
filter(
is.na(count_test_sequence),
response == "left"
) %>%
select(workerId, studyResultId, response, stimtype) %>%
mutate(
RespBinomial = if_else(stimtype == "prototype", 1, 0)
)
View(StudyBinom)
StudyCI <- StudyBinom %>%
group_by(workerId, studyResultId) %>%
summarise(
successes = sum(RespBinomial),
trials = n(),
.groups = "drop"
) %>%
rowwise() %>%
mutate(
confint = list(binconf(successes, trials)),
CI_lower = confint[1, 2],
CI_upper = confint[1, 3]
) %>%
ungroup() %>%
select(workerId, studyResultId, CI_lower, CI_upper)
View(StudyCI)
StudyCR <- StudyCR %>%
left_join(
StudyCI,
by = c("workerId", "studyResultId")
)
StudyCR <- StudyCR %>%
semi_join(
usable,
by = c("workerId", "studyResultId")
)
insufficient_data <- StudyCR %>%
nrow() -
(usable %>% nrow())
View(StudyCR)
# Exclusion criterion based on corrected recognition rate
StudySummary <- StudyCR %>%
filter(CR > 0)
# Exclusion criterion based on uncorrected recognition rate
StudySummary <- StudySummary %>%
filter(CI_lower > 0.33)
ExcludePrototypeRecog <- nrow(StudyCR) - nrow(StudySummary)
# we put an identifier in this tibble
StudySummary <- StudySummary %>%
mutate(
identifier = paste(workerId, studyResultId, sep = "_")
)
# we filter all relevant tibbles to remove excluded IDs
strecog <- strecog %>%
filter(identifier %in% StudySummary$identifier)
test_dat_compl <- test_dat_compl %>%
filter(identifier %in% StudySummary$identifier)
gnet2_data <- gnet2_data %>%
filter(identifier %in% StudySummary$identifier)
norespfam <- test_dat_compl %>%
group_by(identifier) %>%
summarise(fam_missing = sum(fam_NA), .groups = "drop")
norespnew <- test_dat_compl %>%
group_by(identifier) %>%
summarise(new_missing = sum(new_NA), .groups = "drop")
noresp <- norespfam %>%
inner_join(norespnew, by = "identifier") %>%
mutate(
nor = fam_missing + new_missing
)
nrlimit <- 20  # maximum allowed number of missing responses
noresp_ok <- noresp %>%
filter(nor <= nrlimit)
dropbynoresp <- nrow(noresp) - nrow(noresp_ok)
strecog <- strecog %>%
filter(identifier %in% noresp_ok$identifier)
test_dat_compl <- test_dat_compl %>%
filter(identifier %in% noresp_ok$identifier)
gnet2_data <- gnet2_data %>%
filter(identifier %in% noresp_ok$identifier)
View(strecog)
View(test_dat_compl)
8750 / 175
gnet2_register <- read.csv(
"gnet_v2_-_register.csv",
encoding = "UTF-8",
stringsAsFactors = FALSE
) %>%
setNames(c(
"datetime", "workerId", "age", "gen",
"health", "sleep", "coffee", "smoke", "alcdrug"
)) %>%
mutate(workerId = as.character(workerId)) %>%
semi_join(
gnet2_data %>%
distinct(workerId) %>%
mutate(workerId = as.character(workerId)),
by = "workerId"
) %>%
distinct(workerId, .keep_all = TRUE)
