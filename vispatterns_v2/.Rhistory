full_join(difftoprots,  by = c("stimulus_id", "type")) %>%
full_join(diffinnovs,   by = c("stimulus_id", "type")) %>%
full_join(diffinnovs2,  by = c("stimulus_id", "type"))
View(difference_indices)
difference_indices <- difference_indices %>%
relocate(stimulus_id, type, phase)
View(difference_indices)
